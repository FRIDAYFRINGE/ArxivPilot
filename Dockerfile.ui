# Lightweight Streamlit UI — no torch, no sentence-transformers, no qdrant.
# Only needs to call the FastAPI backend over HTTP.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "streamlit>=1.35.0" \
    "requests>=2.32"

COPY src/paper_intel/ui/streamlit_app.py /app/streamlit_app.py

ENTRYPOINT ["streamlit", "run", "/app/streamlit_app.py", \
            "--server.port=8501", \
            "--server.address=0.0.0.0", \
            "--server.headless=true"]
